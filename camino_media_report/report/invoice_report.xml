<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Importe con la moneda como en los ejemplos: "3 536,78 €" o "USD   24 941,39". -->
    <template id="camino_money">
        <span class="cm-money">
            <span t-if="o.currency_id.name != 'EUR'" class="cm-cur" t-out="o.currency_id.name"/>
            <span class="cm-num"><t t-out="o._camino_money(-amount if o.move_type == 'out_refund' else amount)"/><t t-if="o.currency_id.name == 'EUR'">&#160;€</t></span>
        </span>
    </template>

    <template id="camino_invoice_style">
        <style>
            .cm-invoice { font-size: 9pt; color: #14171f; line-height: 1.35; }
            .cm-invoice table, .cm-invoice thead, .cm-invoice tbody, .cm-invoice tr { border: 0 !important; background: transparent; }
            .cm-invoice table { width: 100%; border-collapse: collapse; }
            .cm-invoice table td, .cm-invoice table th { border: 0; vertical-align: top; padding: 0; }
            .cm-invoice .camino-es { font-style: italic; color: #8a909c; }
            .cm-invoice .cm-lbl { font-size: 6.8pt; text-transform: uppercase; letter-spacing: .9px; color: #8a909c; font-weight: bold; margin-bottom: 2px; }
            .cm-invoice .cm-lbl .camino-es { text-transform: none; letter-spacing: 0; font-weight: normal; }
            .cm-invoice .cm-val { font-size: 10pt; font-weight: bold; }

            /* Cabecera */
            .cm-invoice .cm-head { margin-bottom: 10px; }
            .cm-invoice .cm-logo img { max-height: 62px; max-width: 250px; }
            .cm-invoice .cm-brandname { font-size: 15pt; font-weight: bold; color: #5b3f9e; }
            .cm-invoice .cm-doc { text-align: right; }
            .cm-invoice .cm-doctype { font-size: 8pt; letter-spacing: 2px; text-transform: uppercase; color: #5b3f9e; font-weight: bold; }
            .cm-invoice .cm-doctype .camino-es { letter-spacing: 0; text-transform: none; font-weight: normal; }
            .cm-invoice .cm-number { font-size: 21pt; font-weight: bold; line-height: 1.1; margin-top: 2px; }
            .cm-invoice .cm-rule { height: 2px; background: #5b3f9e; margin: 0 0 10px 0; }

            /* Datos de la factura */
            .cm-invoice .cm-meta td { padding: 0 14px 10px 0; }
            .cm-invoice .cm-meta .cm-metaval { font-size: 10pt; font-weight: bold; }

            /* Cliente y emisor */
            .cm-invoice table.cm-parties { border-collapse: separate; border-spacing: 0; }
            .cm-invoice td.cm-party { background: #f6f6fa; border-radius: 6px; padding: 10px 14px; width: 49%; }
            .cm-invoice .cm-party .cm-name { font-size: 11pt; font-weight: bold; margin-bottom: 2px; }
            .cm-invoice .cm-party .cm-row { margin-top: 6px; }
            .cm-invoice .cm-gap { width: 14px; }

            /* Líneas */
            .cm-invoice .cm-lines { margin-top: 14px; }
            .cm-invoice .cm-lines th { text-align: left; font-size: 7pt; letter-spacing: .9px; text-transform: uppercase; color: #8a909c; padding: 0 0 6px 0; border-bottom: 2px solid #14171f; }
            .cm-invoice .cm-lines th.r { text-align: right; }
            .cm-invoice .cm-lines td { padding: 7px 0; border-bottom: 1px solid #e6e7ee; }
            .cm-invoice .cm-concept { font-weight: bold; font-size: 10pt; }
            .cm-invoice .cm-origin { font-weight: normal; color: #6b7280; }
            .cm-invoice .cm-code { display: inline-block; background: #ece6f7; color: #5b3f9e; border-radius: 3px; padding: 0 5px; margin-right: 5px; font-size: 8pt; }
            .cm-invoice .cm-desc { font-style: italic; color: #3b4150; margin-top: 2px; white-space: pre-line; }
            .cm-invoice .cm-trans { margin-top: 2px; font-size: 8.3pt; }
            .cm-invoice .cm-amt { text-align: right; white-space: nowrap; font-weight: bold; font-size: 10pt; padding-left: 14px; }
            .cm-invoice .cm-cur { color: #8a909c; margin-right: 12px; font-weight: normal; }
            .cm-invoice .cm-contact { padding-top: 8px; font-weight: bold; }

            /* Totales */
            .cm-invoice .cm-totals { width: 50%; margin-left: 50%; margin-top: 12px; }
            .cm-invoice .cm-totals td { padding: 4px 0; border-bottom: 1px solid #e6e7ee; }
            .cm-invoice .cm-totals tr.cm-grand td { border: 0; padding: 9px 12px; background: #5b3f9e; color: #fff; font-size: 10.5pt; font-weight: bold; }
            .cm-invoice .cm-totals tr.cm-grand .camino-es { color: #ddd3f2 !important; font-weight: normal; }
            .cm-invoice .cm-totals tr.cm-grand .cm-cur { color: #ddd3f2; }
            .cm-invoice .cm-totals tr.cm-grand td.cm-amt { font-size: 13pt; }
            .cm-invoice .cm-red { color: #c62828; font-weight: bold; }
            .cm-invoice .cm-due { margin-top: 10px; }
            .cm-invoice .cm-legend { margin-top: 8px; font-size: 8.3pt; color: #6b7280; }
            .cm-invoice .cm-vatlegend { margin-top: 10px; }
            .cm-invoice .cm-vl-en { font-size: 9pt; color: #14171f; }
            .cm-invoice .cm-vl-es { font-size: 8pt; color: #8a909c; }

            /* Rectificativa */
            .cm-invoice .cm-credit { border: 2px solid #c62828; background: #fdf0ef; color: #c62828; text-align: center; font-weight: bold; padding: 9px; margin: 16px 20% 4px 20%; border-radius: 6px; letter-spacing: .4px; }
            .cm-invoice .cm-credit .camino-es { color: #c62828 !important; }
            .cm-invoice .cm-credit-es { border: 2px solid #9aa0ab; background: #f4f5f7; color: #8a909c; text-align: center; padding: 7px; margin: 6px 20% 4px 20%; border-radius: 6px; font-size: 8.3pt; letter-spacing: .3px; }

            /* Pago */
            .cm-invoice .cm-pay { margin-top: 12px; page-break-inside: avoid; }
            .cm-invoice .cm-paytitle { font-size: 7.5pt; letter-spacing: 1.2px; text-transform: uppercase; color: #5b3f9e; font-weight: bold; padding-bottom: 5px; border-bottom: 1px solid #d9dbe6; margin-bottom: 7px; }
            .cm-invoice .cm-payhead { font-weight: bold; }
            .cm-invoice .cm-bank td { padding: 2px 0; }
            .cm-invoice .cm-bank td.k { width: 24%; color: #6b7280; font-size: 8.3pt; }
            .cm-invoice .cm-bank td.k .camino-es { color: #a3a8b3; }
            .cm-invoice .cm-bank td.v { font-weight: bold; }
            .cm-invoice .cm-redbox { border-left: 5px solid #c62828; background: #fdf0ef; color: #c62828; font-weight: bold; padding: 8px 12px; margin-top: 9px; border-radius: 0 6px 6px 0; }
            .cm-invoice .cm-redbox div { margin-bottom: 2px; }
        </style>
    </template>

    <!--
        Informe de factura propio de Camino Media: misma información que los modelos
        originales, con un diseño limpio. Todas las etiquetas salen en inglés y español.
    -->
    <template id="report_camino_invoice_document">
        <t t-set="o" t-value="o.with_context(lang=lang)"/>
        <t t-set="company" t-value="o.company_id.sudo().with_context(lang=lang)"/>
        <t t-set="issuer" t-value="o.company_id.sudo().partner_id"/>
        <t t-set="is_credit_note" t-value="o.move_type in ('out_refund', 'in_refund')"/>
        <div class="article cm-invoice" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id"
             t-att-data-oe-lang="o.env.context.get('lang')">
            <t t-call="camino_media_report.camino_invoice_style"/>

            <!-- Cabecera: logotipo de la marca y número de factura. -->
            <table class="cm-head" name="camino_brand_header">
                <tr>
                    <td class="cm-logo" style="vertical-align: middle;">
                        <t t-set="brand_company" t-value="o.company_id.sudo()"/>
                        <t t-if="o.camino_brand == 'camino'">
                            <img t-if="brand_company.camino_media_logo" t-att-src="image_data_uri(brand_company.camino_media_logo)" alt="Camino Media"/>
                            <div t-else="" class="cm-brandname">Camino Media</div>
                        </t>
                        <t t-else="">
                            <img t-if="brand_company.camino_psn_logo" t-att-src="image_data_uri(brand_company.camino_psn_logo)" alt="Production Service Network"/>
                            <div t-else="" class="cm-brandname">Production Service Network</div>
                        </t>
                    </td>
                    <td class="cm-doc" style="vertical-align: middle;">
                        <div class="cm-doctype">
                            <t t-if="is_credit_note" t-out="o._camino_label('credit_note', color='#c62828')"/>
                            <t t-else="" t-out="o._camino_label('invoice')"/>
                        </div>
                        <div class="cm-number" name="invoice_date">
                            <t t-if="o.name and o.name != '/'" t-out="o.name"/>
                            <t t-else="">Draft / Borrador</t>
                            <span t-if="is_credit_note and o.name and 'CREDIT' not in o.name.upper()" class="cm-red" name="camino_credit_tag"> - CREDIT NOTE</span>
                        </div>
                        <div class="cm-lbl" style="margin: 3px 0 0 0;" t-out="o._camino_label('invoice_number')"/>
                    </td>
                </tr>
            </table>
            <div class="cm-rule"/>

            <!-- Datos de la factura. -->
            <table class="cm-meta" name="camino_info_grid">
                <tr>
                    <td style="width: 26%;">
                        <div class="cm-lbl" t-out="o._camino_label('date')"/>
                        <div class="cm-metaval" t-out="o._camino_date(o.invoice_date)"/>
                    </td>
                    <td style="width: 34%;" name="camino_purchase_order">
                        <div class="cm-lbl" t-out="o._camino_label('purchase_order_number')"/>
                        <div class="cm-metaval" t-out="o.camino_purchase_order or 'N/A'"/>
                    </td>
                    <td name="camino_location">
                        <div class="cm-lbl" t-out="o._camino_label('location')"/>
                        <div class="cm-metaval" t-out="o.camino_location or 'N/A'"/>
                    </td>
                </tr>
                <tr>
                    <td colspan="3" name="camino_shoot_dates">
                        <div class="cm-lbl" t-out="o._camino_label('shoot_dates')"/>
                        <div class="cm-metaval" t-out="o.camino_shoot_dates or 'N/A'"/>
                    </td>
                </tr>
                <tr t-if="o.camino_project_code">
                    <td colspan="3" name="camino_project_code" style="padding-top: 2px;">
                        <div class="cm-lbl" t-out="o._camino_label('project_code')"/>
                        <div class="cm-metaval" t-out="o.camino_project_code"/>
                    </td>
                </tr>
            </table>

            <!-- Cliente y emisor. -->
            <table class="cm-parties" name="camino_parties" style="margin-top: 4px;">
                <tr>
                    <td class="cm-party" name="camino_client">
                        <div class="cm-lbl" t-out="o._camino_label('client')"/>
                        <div class="cm-name" t-out="o.partner_id.commercial_partner_id.name"/>
                        <div t-foreach="o._camino_partner_lines(o.partner_id)" t-as="addr_line" t-out="addr_line"/>
                        <div class="cm-row">
                            <div class="cm-lbl" t-out="o._camino_label('vat_cif')"/>
                            <div class="cm-val" t-out="o._camino_vat(o.partner_id.commercial_partner_id)"/>
                        </div>
                    </td>
                    <td class="cm-gap"/>
                    <td class="cm-party" name="camino_issuer">
                        <div class="cm-lbl" t-out="o._camino_label('issued_by')"/>
                        <div class="cm-name" t-out="issuer.name"/>
                        <div t-foreach="o._camino_partner_lines(issuer)" t-as="addr_line" t-out="addr_line"/>
                        <table name="camino_issuer_contact" style="margin-top: 6px;">
                            <tr>
                                <td style="width: 46%;">
                                    <div class="cm-lbl" t-out="o._camino_label('vat_cif')"/>
                                    <div class="cm-val" t-out="o._camino_vat(issuer)"/>
                                </td>
                                <td>
                                    <div class="cm-lbl" t-out="o._camino_label('telephone')"/>
                                    <div class="cm-val" t-if="issuer.phone" t-out="issuer.phone"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="padding-top: 5px;">
                                    <div class="cm-lbl" t-out="o._camino_label('email')"/>
                                    <div class="cm-val" t-out="issuer.email"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- Líneas. -->
            <table class="cm-lines" name="invoice_line_table">
                <thead>
                    <tr>
                        <th name="th_description">Description <span class="camino-es">/ Descripción</span></th>
                        <th class="r" style="width: 24%;" name="th_subtotal" t-out="o._camino_amount_header()"/>
                    </tr>
                </thead>
                <tbody class="invoice_tbody">
                    <t t-foreach="o.invoice_line_ids.sorted(key=lambda l: (l.sequence, l.id))" t-as="line">
                        <tr t-if="line.display_type == 'product'">
                            <td name="account_invoice_line_name">
                                <t t-set="name_parts" t-value="(line.name or '').split('\n')"/>
                                <t t-set="origin_text" t-value="o._camino_line_origin(line)"/>
                                <div class="cm-concept">
                                    <span class="cm-code" t-if="line.camino_project_code and line.camino_project_code not in (line.name or '')" t-out="line.camino_project_code"/>
                                    <t t-out="name_parts[0]"/>
                                    <span class="cm-origin" t-if="origin_text"> (<t t-out="origin_text"/>)</span>
                                </div>
                                <t t-foreach="name_parts[1:]" t-as="extra_line">
                                    <div t-if="extra_line.strip()" t-out="extra_line"/>
                                </t>
                                <div class="cm-desc" t-if="line.camino_description" t-out="line.camino_description"/>
                                <div class="cm-trans camino-es" t-if="line.camino_name_es" t-out="line.camino_name_es"
                                     style="font-style: italic; color: #8a909c; white-space: pre-line;"/>
                            </td>
                            <td class="cm-amt" name="td_subtotal">
                                <t t-call="camino_media_report.camino_money"><t t-set="amount" t-value="line.price_subtotal"/></t>
                            </td>
                        </tr>
                        <tr t-elif="line.display_type == 'line_section'">
                            <td colspan="2" style="font-weight: bold;" t-out="line.name"/>
                        </tr>
                        <tr t-elif="line.display_type == 'line_note'">
                            <td colspan="2" style="font-style: italic;" t-out="line.name"/>
                        </tr>
                    </t>
                </tbody>
            </table>
            <div class="cm-contact" t-if="o.camino_contact" name="camino_contact">
                <span t-out="o._camino_label('contact_label')"/>: <span t-out="o.camino_contact"/>
            </div>

            <!-- Rectificativa: caja roja en inglés y caja gris en español con la factura que rectifica. -->
            <t t-if="is_credit_note">
                <t t-set="credit_texts" t-value="o._camino_credit_note_texts()"/>
                <div class="cm-credit" name="camino_credit_note_box">
                    <div t-out="o._camino_pair('credit_note_to')[0]"/>
                    <div><t t-out="o._camino_pair('to_invoice')[0]"/> <t t-out="credit_texts[0]"/></div>
                </div>
                <div class="cm-credit-es" name="camino_credit_note_box_es">
                    <div t-out="o._camino_pair('credit_note_to')[1]"/>
                    <div><t t-out="o._camino_pair('to_invoice')[1]"/> <t t-out="credit_texts[1]"/></div>
                </div>
            </t>

            <!-- Totales. -->
            <t t-set="vat_legend" t-value="o._camino_vat_legend()"/>
            <table class="cm-totals" name="camino_totals">
                <tr>
                    <td><strong t-out="o._camino_label('sub_total')"/></td>
                    <td class="cm-amt"><t t-call="camino_media_report.camino_money"><t t-set="amount" t-value="o.amount_untaxed"/></t></td>
                </tr>
                <tr>
                    <td><strong t-out="o._camino_label('tax_base')"/></td>
                    <td class="cm-amt"><t t-call="camino_media_report.camino_money"><t t-set="amount" t-value="o.amount_untaxed"/></t></td>
                </tr>
                <tr>
                    <t t-set="vat_key" t-value="o._camino_vat_label()"/>
                    <td><strong t-out="o._camino_label(vat_key[0])"/> <span t-if="vat_key[1]" t-out="vat_key[1]"/><strong t-if="vat_legend"> *</strong></td>
                    <td class="cm-amt">
                        <t t-if="vat_key[0] == 'vat_exempt'">-<t t-if="o.currency_id.name == 'EUR'">&#160;€</t></t>
                        <t t-else=""><t t-call="camino_media_report.camino_money"><t t-set="amount" t-value="o.amount_tax"/></t></t>
                    </td>
                </tr>
                <tr class="cm-grand">
                    <td><t t-out="o._camino_label('total', middle=(o.name if o.name and o.name != '/' else None))"/></td>
                    <td class="cm-amt"><t t-call="camino_media_report.camino_money"><t t-set="amount" t-value="o.amount_total"/></t></td>
                </tr>
            </table>
            <div class="cm-vatlegend" t-if="vat_legend" name="camino_vat_legend">
                <t t-set="legend_long" t-value="len(vat_legend[0]) > 40"/>
                <span class="cm-vl-en">* <t t-out="vat_legend[0]"/></span>
                <t t-if="vat_legend[1]">
                    <t t-if="not legend_long">&#160;&#160;</t>
                    <span class="cm-vl-es" t-att-style="'display: block;' if legend_long else None" t-out="vat_legend[1]"/>
                </t>
            </div>
            <div class="cm-red cm-due" t-if="not is_credit_note and o.invoice_payment_term_id and not is_html_empty(o.invoice_payment_term_id.note)"
                 name="camino_payment_due" t-out="o.invoice_payment_term_id.note"/>
            <div class="cm-legend" t-if="not vat_legend and not is_html_empty(o.fiscal_position_id.note)" name="camino_fiscal_legend"
                 t-out="o.fiscal_position_id.note"/>

            <!-- Pago: la cuenta la elige Odoo según la moneda de la factura. -->
            <t t-if="o.move_type == 'out_invoice' and o.partner_bank_id">
                <t t-set="bank" t-value="o.partner_bank_id"/>
                <div class="cm-pay" name="camino_bank_block">
                    <div class="cm-red" style="margin-bottom: 6px;" t-if="bank.camino_account_notice" name="camino_account_notice"
                         t-out="bank.camino_account_notice"/>
                    <div class="cm-paytitle">Payment details <span class="camino-es">/ Datos de pago</span></div>
                    <div class="cm-payhead">
                        <t t-if="bank.camino_payment_title">
                            <div t-foreach="bank.camino_payment_title.split('\n')" t-as="title_line" t-out="title_line"/>
                        </t>
                        <t t-else=""><div t-out="o._camino_label('payment_default')"/></t>
                        <div t-out="o._camino_label('cite_invoice')"/>
                    </div>
                    <table class="cm-bank" style="margin-top: 6px;">
                        <tr>
                            <td class="k"><t t-out="o._camino_label('beneficiary')"/></td>
                            <td class="v" t-out="bank.acc_holder_name"/>
                        </tr>
                        <tr>
                            <td class="k"><t t-out="o._camino_label('bank')"/></td>
                            <td class="v" t-out="bank.bank_id.name"/>
                        </tr>
                        <tr>
                            <td class="k"><t t-out="o._camino_label('swift')"/></td>
                            <td class="v" t-out="bank.bank_bic"/>
                        </tr>
                        <tr>
                            <td class="k"><t t-out="o._camino_label('iban')"/></td>
                            <td class="v" t-out="bank.acc_number"/>
                        </tr>
                        <tr t-if="bank.camino_intermediary_bic">
                            <td class="k"><t t-out="o._camino_label('intermediary_bic')"/></td>
                            <td class="v" t-out="bank.camino_intermediary_bic"/>
                        </tr>
                        <tr t-if="bank.camino_bank_address">
                            <td class="k"><t t-out="o._camino_label('bank_address')"/></td>
                            <td t-out="bank.camino_bank_address" style="white-space: pre-line;"/>
                        </tr>
                    </table>
                    <!-- Caja roja: las comisiones bancarias. La de la cuenta si la tiene; si no, el aviso estándar. -->
                    <div class="cm-redbox" name="camino_payment_notice">
                        <t t-if="bank.camino_invoice_warning">
                            <div t-foreach="bank.camino_invoice_warning.split('\n')" t-as="warn_line" t-out="warn_line"/>
                        </t>
                        <t t-else="">
                            <t t-set="notice" t-value="o._camino_pair('payment_notice')"/>
                            <div t-out="notice[0]"/>
                            <div t-out="notice[1]"/>
                        </t>
                    </div>
                </div>
            </t>

            <!--
                Pie: datos registrales de la compañía. Odoo saca el div.footer del contenido y lo
                pinta en el margen inferior de cada página, así que siempre queda al final.
                Va con estilos en línea porque el pie se renderiza aparte del resto del documento.
            -->
            <div class="footer" name="camino_footer" t-if="company.report_footer">
                <div style="text-align: center; color: #8a909c; font-size: 7.3pt; line-height: 1.3; border-top: 1px solid #e6e7ee; padding: 5px 14mm 0 14mm; margin: 0 8mm;">
                    <t t-out="company.report_footer"/>
                </div>
            </div>
        </div>
    </template>

    <!--
        Odoo elige la plantilla con _get_name_invoice_report (como hacen las localizaciones),
        así que la plantilla estándar queda intacta para el resto de documentos.
        El margen superior se reduce para las facturas de cliente: no llevan la cabecera de Odoo.
    -->
    <template id="report_invoice" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-call='account.report_invoice_document']" position="after">
            <t t-elif="o._get_name_invoice_report() == 'camino_media_report.report_camino_invoice_document'"
               t-call="camino_media_report.report_camino_invoice_document"
               t-lang="lang"/>
        </xpath>
        <xpath expr="//t[@t-call='web.html_container']" position="inside">
            <t t-set="camino_only" t-value="all(d._get_name_invoice_report() == 'camino_media_report.report_camino_invoice_document' for d in docs)"/>
            <t t-if="camino_only" t-set="data_report_margin_top" t-value="9"/>
            <t t-if="camino_only" t-set="data_report_header_spacing" t-value="1"/>
            <t t-if="camino_only" t-set="data_report_margin_bottom" t-value="16"/>
        </xpath>
    </template>

    <!--
        Odoo admite el margen inferior por documento (data-report-margin-bottom), pero la
        plantilla base no lo emite. Solo se escribe el atributo cuando un informe lo pide.
    -->
    <template id="report_layout" inherit_id="web.report_layout">
        <xpath expr="//html" position="attributes">
            <attribute name="t-att-data-report-margin-bottom">data_report_margin_bottom</attribute>
        </xpath>
    </template>
</odoo>
