<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_camino" model="ir.ui.view">
        <field name="name">res.company.form.camino.media</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Invoice Branding" name="camino_branding">
                    <group>
                        <field name="camino_psn_logo" widget="image" options="{'size': [0, 120]}"/>
                        <field name="camino_media_logo" widget="image" options="{'size': [0, 120]}"/>
                        <field name="camino_print_line_origin"/>
                        <field name="camino_invoice_follower_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
